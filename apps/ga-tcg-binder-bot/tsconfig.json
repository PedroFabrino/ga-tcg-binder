{
  "compilerOptions": {
    "target": "es2020",
    "composite": true,
    "declaration": true,
    "outDir": "dist",
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "sourceMap": false,
    "allowJs": false,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "../../"
  },
  "include": [
    "src/**/*.ts",
    "../../src/db/index.ts",
    "../../src/db/schema.ts",
    "../../src/db/repositories/marketplace-repository.ts",
    "../../src/services/market-notification-formatter.ts"
  ],
  "exclude": ["node_modules"]
}
