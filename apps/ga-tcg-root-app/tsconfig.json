{
  "compilerOptions": {
    "target": "es2022",
    "composite": false,
    "declaration": true,
    "outDir": "dist",
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "sourceMap": false,
    "allowJs": false,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "../../",
    "paths": {
      "@ga/contracts": ["../../packages/contracts/src/index.ts"],
      "@ga/gen-shared": ["./networking/gen/shared/src/index.ts"],
      "@ga/gen-server": ["./networking/gen/server/src/index.ts"],
      "@ga/gen-client": ["./networking/gen/client/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../../packages/contracts/src/**/*.ts",
    "networking/gen/server/src/**/*.ts",
    "networking/gen/shared/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/**/*.test.ts",
    "src/__tests__/**",
    "../../packages/contracts/src/**/*.test.ts"
  ]
}
