# Root Bot Configuration
#
# The cloud bot is secret-free: it holds no Turso or Discord credentials. It
# registers once via `POST /api/root-bot/install` and stores only its per-install
# token in Root's `dataStore.appData`.
#
# The API base URL is compiled into the bundle for Root cloud deploys; set it in
# `src/root-bot-config.ts`. This env override is for local development only.
ROOT_BOT_API_BASE_URL=

# Local devhost only: selects the community the bot attaches to.
# Root's cloud supplies the community in production.
DEV_TOKEN=

# Poll intervals (local override; defaults are in code).
ROOT_BOT_POLL_INTERVAL_MS=30000
ROOT_DEAL_ALERT_INTERVAL_MS=300000

# Deploy tooling only (`npm run upload` / `deploy`). Never read by the bot at
# runtime and never shipped to the cloud.
ROOT_BOT_AUTH_TOKEN=
