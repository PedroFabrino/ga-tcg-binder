{
  "name": "@ga/root-app",
  "author": "",
  "description": "Grand Archive TCG Collector Assistant & Market Notifier Root App",
  "version": "1.0.2",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ga/gen-client": "file:./networking/gen/client",
    "@ga/gen-server": "file:./networking/gen/server",
    "@ga/gen-shared": "file:./networking/gen/shared",
    "@rootsdk/client-app": "^0.21.3",
    "@rootsdk/server-app": "^0.21.3",
    "@rootsdk/server-bot": "*",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@rootsdk/dev-tools": "*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.8.2",
    "vite": "^8.3.5"
  },
  "scripts": {
    "build:client": "vite build --config client/vite.config.mjs client",
    "build": "tsc && node -e \"if (fs.existsSync('dist/apps/ga-tcg-root-app/src/main.js')) fs.writeFileSync('dist/main.js', 'require(\\\"./apps/ga-tcg-root-app/src/main.js\\\");\\n');\" && npm run build:client",
    "clean": "node clean.js",
    "bot": "rootsdk start devhost",
    "package": "node scripts/package.js",
    "upload": "node scripts/upload.js",
    "deploy": "npm run build && npm run package && npm run upload"
  }
}
