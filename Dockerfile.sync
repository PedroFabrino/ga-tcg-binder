FROM lexiforest/curl-impersonate:latest AS curl-impersonate-src

FROM node:20-bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable && corepack prepare pnpm@latest --activate \
  && groupadd -r app && useradd -r -g app -m app \
  && chown -R app:app /app

COPY --from=curl-impersonate-src /usr/local/bin/curl-impersonate /usr/local/bin/curl-impersonate
COPY --from=curl-impersonate-src /usr/local/bin/curl_chrome152 /usr/local/bin/curl_chrome152

USER app

COPY --chown=app:app package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY --chown=app:app apps/mobile/package.json ./apps/mobile/
COPY --chown=app:app packages/contracts/package.json ./packages/contracts/
COPY --chown=app:app services/ws-gateway/package.json ./services/ws-gateway/

RUN pnpm install --frozen-lockfile

COPY --chown=app:app . .

ENV NODE_ENV=production

CMD ["pnpm", "exec", "tsx", "scripts/sync-daemon.ts"]
