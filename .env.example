# ==============================================================================
# Turso (libSQL) Database Persistence (Required for Vercel Serverless)
# ==============================================================================
# In production on Vercel, serverless functions are ephemeral and cannot use
# local disk SQLite ('file:local.db'). Connect to Turso over HTTP:
TURSO_DATABASE_URL=libsql://your-database-name-organization.turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-auth-token

# ==============================================================================
# Auth.js / NextAuth (Required for Social OAuth & Session Encryption)
# ==============================================================================
# Generate a secret with: openssl rand -base64 33
AUTH_SECRET=your-random-generated-32-char-secret-string

# Canonical deployment URL
AUTH_URL=https://your-domain.vercel.app

# Discord OAuth Provider (Optional / If using Discord sign-in)
AUTH_DISCORD_ID=your-discord-client-id
AUTH_DISCORD_SECRET=your-discord-client-secret

# Google OAuth Provider (Optional / If using Google sign-in)
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# ==============================================================================
# Discord Market Notifications (Optional)
# ==============================================================================
# Webhook URL for the Discord market-notification sink. The URL embeds a
# secret token — never commit a real value or log it. Missing or invalid
# values disable the sink with a warning.
DISCORD_WEBHOOK=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# ==============================================================================
# Deal Alerts (Discord DMs + Root private channels)
# ==============================================================================
# Comma-separated destinations. Defaults to both. Each delivery process still
# requires its own credentials before it actually sends anything.
DEAL_ALERT_DM_DESTINATION=discord-dm,root-alert

# Discord bot token (opens/reuses DMs for Discord deal alerts)
DISCORD_BOT_TOKEN=your-discord-bot-token

# Root bot: shared market-notification channel and poll interval
ROOT_BOT_MARKET_CHANNEL_ID=
ROOT_BOT_POLL_INTERVAL_MS=30000

# Root deal alerts: the bot-only channel section (channel group) that holds the
# per-user private channels. When unset, Root deal alerts are disabled.
ROOT_DEAL_ALERT_SECTION_ID=
ROOT_DEAL_ALERT_INTERVAL_MS=300000

# ==============================================================================
# Feature Flags (Defaults to false when omitted)
# ==============================================================================
# Web scanner & paired mobile camera recognition
NEXT_PUBLIC_FEATURE_SCANNER=false

# Mobile companion scanner tab & viewfinder
EXPO_PUBLIC_FEATURE_SCANNER=false

